)
print(results)
library(fastICA)
library(tidyverse)
weather =  read_csv("data/full_weather.csv")
ica_variables = weather %>%
select("temperature_2m_mean (°C)","shortwave_radiation_sum (MJ/m²)",
"et0_fao_evapotranspiration (mm)", "daylight_duration (s)",
"sunshine_duration (s)", "precipitation_sum (mm)",
"precipitation_hours (h)", "cloud_cover_mean (%)",
"dew_point_2m_mean (°C)","wind_gusts_10m_mean (m/s)",
"wind_speed_10m_mean (m/s)" )
weather_scaled <- scale(ica_variables)
set.seed(123)
n_comp <- 4
ica <- fastICA(weather_scaled, n.comp = n_comp, alg.typ = "deflation",
fun = "logcosh", method = "C", maxit = 1000)
# --- 2. Interpret Loadings (Which weather variables drive which IC?) ---
# Transpose A matrix: Rows = Variables, Cols = Components
loadings <- as.data.frame(t(ica$A))
colnames(loadings) <- paste0("IC", 1:n_comp)
rownames(loadings) <- colnames(weather_scaled)
# Create a "Clean" Loading Table: hide small coefficients to see patterns
clean_loadings <- loadings %>%
mutate(across(everything(), ~ ifelse(abs(.x) < 0.4, "-", as.character(round(.x, 2)))))
print("--- Cleaned Loadings Matrix ---")
print(clean_loadings)
# --- 3. Relative Contribution (%) ---
# How much each variable contributes to the total signal of that IC
contrib_pct <- apply(abs(ica$A), 2, function(x) round((x / sum(x)) * 100, 1))
rownames(contrib_pct) <- colnames(weather_scaled)
contrib <- abs(ica$A)
# sweep() divides each element by the sum of its row (the total "signal" of that IC)
contrib_pct <- sweep(contrib, 1, rowSums(contrib), "/") * 100
# Now we transpose so it matches your variables-as-rows format
contrib_pct_table <- t(round(contrib_pct, 1))
# Assign names
rownames(contrib_pct_table) <- colnames(weather_scaled)
colnames(contrib_pct_table) <- paste0("IC", 1:n_comp)
print("--- Contribution Percentage per Component ---")
print(contrib_pct_table)
# Calculate percentage contribution in one go
contrib <- t(round(prop.table(abs(ica$A), margin = 1) * 100, 1))
# Assign names to the resulting matrix
dimnames(contrib) <- list(colnames(weather_scaled), paste0("IC", 1:n_comp))
print(contrib)
comp_vars <- apply(ica$S, 2, var)
cat("\nComponent Variances:\n")
print(round(comp_vars, 3))
weather_fin
library(fastICA)
library(tidyverse)
weather =  read_csv("data/full_weather.csv")
ica_variables = weather %>%
select("temperature_2m_mean (°C)","shortwave_radiation_sum (MJ/m²)",
"et0_fao_evapotranspiration (mm)", "daylight_duration (s)",
"sunshine_duration (s)", "precipitation_sum (mm)",
"precipitation_hours (h)", "cloud_cover_mean (%)",
"dew_point_2m_mean (°C)","wind_gusts_10m_mean (m/s)",
"wind_speed_10m_mean (m/s)" )
weather_scaled <- scale(ica_variables)
#running ICA
set.seed(123)
n_comp <- 4
ica <- fastICA(weather_scaled, n.comp = n_comp, alg.typ = "deflation",
fun = "logcosh", method = "C", maxit = 1000)
#loading matrix
loadings <- as.data.frame(t(ica$A))
colnames(loadings) <- paste0("IC", 1:n_comp)
rownames(loadings) <- colnames(weather_scaled)
clean_loadings <- loadings %>%
mutate(across(everything(), ~ ifelse(abs(.x) < 0.4, "-", as.character(round(.x, 2)))))
print(clean_loadings)
#relative contributions
contrib <- t(round(prop.table(abs(ica$A), margin = 1) * 100, 1))
dimnames(contrib) <- list(colnames(weather_scaled), paste0("IC", 1:n_comp))
print(contrib)
#add names
colnames(ica$S) <- paste0("IC", 1:n_comp)
# compiling with lag values
weather_fin <- weather %>%
select(1:6) %>%
cbind(ica$S) %>%
arrange(day) %>%
# Create 1, 2, and 3-day lags for ALL ICs at once
mutate(across(starts_with("IC"),
list(lag1 = ~lag(.x, 1),
lag2 = ~lag(.x, 2),
lag3 = ~lag(.x, 3)),
.names = "{.col}_{.fn}"))
# reconstruction error
recon_error <- mean(abs(weather_scaled - (ica$S %*% ica$A)))
print(recon_error)
write_csv()
View(weather_fin)
View(weather_fin)
