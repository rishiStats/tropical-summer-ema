boot_ica <- fastICA(weather_scaled[boot_idx, ], n.comp = n_comp, method = "C")
rot <- procrustes(as.matrix(boot_ica$S), as.matrix(ica$S))
cor_matrix <- abs(cor(rot$P, ica$S))
