# mean mutual information
S_disc <- discretize(ica$S, nbins = ceiling(sqrt(nrow(ica$S))))
mi_pairs <- combn(ncol(S_disc), 2, function(x) {
mutinformation(S_disc[, x[1]], S_disc[, x[2]])
})
mean_mi <- mean(mi_pairs)
#average correlation
corr_matrix <- cor(ica$S)
