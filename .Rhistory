Predictor = rownames(ct),
Estimate  = ct[, "Estimate"],
SE        = ct[, "Std. Error"],
OR        = exp(ct[, "Estimate"]),
Lower_CI  = exp(ct[, "Estimate"] - 1.96 * ct[, "Std. Error"]),
Upper_CI  = exp(ct[, "Estimate"] + 1.96 * ct[, "Std. Error"]),
p_value   = ct[, "Pr(>|z|)"]
)
