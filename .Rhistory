# Normality test and plot
shapiro.test(re_effects)  # Shapiro-Wilk
qqnorm(re_effects); qqline(re_effects, col = "red")
hist(re_effects, breaks = 20, main = "Random Effects Distribution")
# If multiple RE terms, loop or specify
